<div class="container mt-5">
    <h2>Music Playlist</h2>
    {{#if user}}
    <a href="/songs/add" class="btn btn-primary mb-3">
        Add Song
    </a>
    {{/if}}
    <table class="table table-hover table-striped">
        <thead>
            <tr>
                <th>Title</th>
                <th>Artist</th>
                <th>Album</th>
                <th>Genre</th>
                <th>Year</th>
                <th class="text-center">Action</th>
            </tr>
        </thead>
        <tbody>
            {{#each songs}}
            <tr>
                <td>{{title}}</td>
                <td>{{artist}}</td>
                <td>{{album}}</td>
                <td>{{genre}}</td>
                <td>{{year}}</td>
                {{#if user}}
                <td class="text-center">
                    <a href="/songs/edit/{{_id}}" class="btn btn-warning btn-sm">
                        Edit
                    </a>
                    <a href="/songs/delete/{{_id}}"
                       class="btn btn-danger btn-sm"
                       onclick="return confirm('Delete this song?')">
                        Delete
                    </a>
                   {{/if}}
                </td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</div>